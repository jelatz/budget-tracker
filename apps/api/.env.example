# Node.js + Hono API runtime configuration (Railway & local dev)
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# PostgreSQL connection string (Railway Postgres, local Postgres, or any Postgres provider)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/budget_tracker
# Optional direct/unpooled connection string used by drizzle-kit migrations
# DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:5432/budget_tracker

# Keep pool lean for low idle RAM on Railway
DB_POOL_MAX=5

# Comma-separated allowed browser origins for CORS (e.g. your Cloudflare Pages or custom frontend domain)
# Local Expo dev origins (localhost:8081, localhost:19006, localhost:3000) are included automatically when NODE_ENV != production.
# Vercel deployment origins (VERCEL_URL, VERCEL_BRANCH_URL, VERCEL_PROJECT_PRODUCTION_URL) are included automatically when present.
CORS_ORIGINS=https://budget-tracker.pages.dev

# Minimum supported mobile app version for the client update gate
MIN_SUPPORTED_VERSION=1.0.0

# Keep false in production; set true only for local demo shortcuts
ALLOW_UNAUTHENTICATED_DEMO=false
