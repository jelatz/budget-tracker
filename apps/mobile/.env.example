# Public HTTPS URL of your deployed @repo/api backend (Railway, or local dev server).
# Leave unset on all-in-one Vercel deployments (Web automatically falls back to same-origin window.location.origin).
# For native mobile builds (EAS/Expo Go) or standalone static hosting (e.g. Cloudflare Pages), set this explicitly.
EXPO_PUBLIC_API_URL=http://localhost:3000
