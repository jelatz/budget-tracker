{
  "name": "budget-tracker-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "start": "pnpm --filter @repo/mobile start",
    "ios": "pnpm --filter @repo/mobile ios",
    "android": "pnpm --filter @repo/mobile android",
    "web": "pnpm --filter @repo/mobile web",
    "mobile": "pnpm --filter @repo/mobile start",
    "api": "pnpm --filter @repo/api dev",
    "api:build": "pnpm --filter @repo/api build",
    "api:start": "pnpm --filter @repo/api start",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "~6.0.3"
  }
}
